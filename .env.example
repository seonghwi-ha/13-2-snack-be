# Database
DATABASE_URL=

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=3d

# Frontend origin for CORS
CLIENT_URL=http://localhost:3000

# Redis (선택) 상품 목록 캐시. 비워두면 캐시 없이 DB에서 바로 읽는다.
# 예) redis://localhost:6379
REDIS_URL=

# AWS
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=

# 이미지 주소 앞부분. 프론트가 rewrites(/api)를 거쳐 이미지 API를 부르므로 /api
API_BASE=/api

# Cloudflare Turnstile (로그인 반복 실패 시 보안 확인)
# 로컬 테스트 키: 1x0000000000000000000000000000000AA(항상 통과), 2x0000000000000000000000000000000AA(항상 실패)
TURNSTILE_SECRET_KEY=

# Swagger
SWAGGER_SERVER_URL=

# Gmail
GMAIL_USER=
GMAIL_APP_PASSWORD=