@baseUrl = http://localhost:3001

### 시드 계정 (비밀번호 모두 Password123!)
# superadmin@snack.com   SUPER_ADMIN
# admin@snack.com        ADMIN    (시드 상품 16개를 전부 이 계정이 등록함)
# user@snack.com         GENERAL
# staff01@snack.com      GENERAL  (다른 일반 유저로 권한 확인용)

### 주의
# - 시드를 돌리면 id가 1부터 다시 매겨집니다. 아래 변수는 시드 직후 기준 값입니다.
#   다만 카테고리·상품은 시드에서 여러 개를 동시에 만들어 순서가 바뀔 수 있으니,
#   결과가 이상하면 2번·14번 응답을 보고 변수를 바꿔 넣으세요.
# - 로그인은 같은 IP에서 15분에 5번까지입니다. 이 파일은 로그인을 3번 하므로
#   전체를 두 번 연달아 돌리면 6번째 로그인에서 429가 납니다.
# - 시드 회사가 하나뿐이라 "다른 회사 상품은 404"는 시드로 확인할 수 없습니다.

# 2번 응답에서 '과자' 대분류 id (소분류들의 category.parentId)
@parentCategoryId = 1
# 2번 응답에서 '초콜릿' 소분류 id (홈런볼·빼빼로의 category.id)
@subCategoryId = 5
# 2번 응답에서 admin이 등록한 시드 상품 id (새우깡 등)
@seedProductId = 1
# 14번 응답의 data.id (user가 직접 등록한 상품)
@myProductId = 18

### 1. 로그인 - 일반 유저
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "user@snack.com", "password": "Password123!" }

### --- 목록 ---

### 2. 상품 목록 기본값 (200 예상)
# sort=latest, page=1, limit=10
# 삭제된 '단종 과자'는 나오면 안 됨
# 여기서 위 변수에 넣을 카테고리·상품 id를 확인하세요
GET {{baseUrl}}/products

### 3. 무한 스크롤 - 첫 페이지 (200 예상)
# 시드 직후면 totalCount 16, totalPages 4, hasNext true
GET {{baseUrl}}/products?limit=5&page=1

### 4. 무한 스크롤 - 마지막 페이지 (200 예상)
# hasNext false 여야 함
GET {{baseUrl}}/products?limit=5&page=4

### 4-1. 마지막 페이지를 넘는 요청 (400 예상)
# "page는 4 이하여야 합니다."
GET {{baseUrl}}/products?limit=5&page=5

### 4-2. 결과가 0건이면 1페이지는 빈 목록 (200 예상)
# 없는 상품명으로 검색 → products 빈 배열, totalPages 0
GET {{baseUrl}}/products?keyword=존재하지않는상품

### 4-3. 결과가 0건일 때 2페이지 (400 예상)
# "page는 1 이하여야 합니다."
GET {{baseUrl}}/products?keyword=존재하지않는상품&page=2

### 4-4. 커서 방식 - 첫 묶음 (200 예상)
# 첫 요청은 page로 보내고, 응답의 nextCursor로 이어서 요청한다.
# @name cursorFirst
GET {{baseUrl}}/products?limit=5

### 4-5. 커서 방식 - 다음 묶음 (200 예상)
# page, totalPages 없이 products, totalCount, hasNext, nextCursor만 온다.
GET {{baseUrl}}/products?limit=5&cursor={{cursorFirst.response.body.data.nextCursor}}

### 4-6. 정렬을 바꾸고 이전 커서를 보냄 (400 예상)
# code INVALID_CURSOR, "올바르지 않은 커서입니다."
GET {{baseUrl}}/products?limit=5&sort=popular&cursor={{cursorFirst.response.body.data.nextCursor}}

### 4-7. 조작한 커서 (400 예상)
GET {{baseUrl}}/products?cursor=not-a-cursor

### 5. 이름 검색 (200 예상)
# 초코파이만 나와야 함
GET {{baseUrl}}/products?keyword=초코

### 5-0. 오타 검색 - 비슷한 상품명 추천 (200 예상)
# products 빈 배열, suggestions ["농심 새우깡", "새우깡"]
GET {{baseUrl}}/products?keyword=새우강

### 5-1. 영문 대소문자 무시 검색 (200 예상)
# 14번으로 'Coca Cola Zero' 같은 영문 상품을 등록한 뒤 실행하세요.
# 소문자로 검색해도 나와야 합니다. (Prisma mode: insensitive)
GET {{baseUrl}}/products?keyword=coca

### 6. 소분류 필터 (200 예상)
# 홈런볼, 빼빼로만 나와야 함
GET {{baseUrl}}/products?categoryId={{subCategoryId}}

### 7. 대분류 필터 (200 예상)
# 과자 아래 소분류(칩·쿠키·초콜릿·젤리·사탕 등) 상품이 모두 나와야 함
# 음료 쪽 상품(콜라·아메리카노 등)은 나오면 안 됨
GET {{baseUrl}}/products?parentCategoryId={{parentCategoryId}}&limit=20

### 7-1. 소분류 파라미터에 대분류 id를 넣은 경우 (200 예상, 0건)
# categoryId는 소분류 하나만 뜻하므로 대분류 id를 넣으면 섞여 나오지 않고 빈 목록이어야 함
GET {{baseUrl}}/products?categoryId={{parentCategoryId}}

### 8. 정렬 - 판매량순 (200 예상)
# purchaseCount 내림차순
GET {{baseUrl}}/products?sort=popular&limit=20

### 9. 정렬 - 낮은 가격순 (200 예상)
# 가격이 같은 상품(1500·1800·2000·2500원)은 id 큰 순으로 고정되어야 함
GET {{baseUrl}}/products?sort=priceAsc&limit=20

### 10. 정렬 - 높은 가격순 (200 예상)
GET {{baseUrl}}/products?sort=priceDesc&limit=20

### --- 상품 등록 내역 (내가 등록한 상품) ---

### 10-1. 내가 등록한 상품 목록 (200 예상)
# 시드 상품은 admin이 등록했으므로 user로 로그인하면 0건이어야 함
# 14번(상품 등록)을 먼저 실행하면 그 상품만 나와야 함
GET {{baseUrl}}/me/products

### 10-2. 내 상품 + 검색·정렬 조합 (200 예상)
# 목록 조건은 GET /products와 동일하게 동작해야 함
GET {{baseUrl}}/me/products?keyword=테스트&sort=priceAsc&limit=5

### 10-3. 쿠키 없이 내 상품 조회 (401 예상)
# 34번(로그아웃) 이후에 실행하세요
GET {{baseUrl}}/me/products

### --- 상세 ---

### 11. 상품 상세 (200 예상)
# productUrl, createdBy(id, name)까지 나와야 함
GET {{baseUrl}}/products/{{seedProductId}}

### 12. 없는 상품 (404 예상)
# "상품을 찾을 수 없습니다."
GET {{baseUrl}}/products/99999

### 13. id가 숫자가 아님 (400 예상)
# "올바른 상품 ID가 아닙니다."
GET {{baseUrl}}/products/abc

### --- 등록 ---

### 14. 상품 등록 - 일반 유저 (201 예상)
# 응답의 data.id 를 맨 위 @myProductId 에 넣으세요
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "포카칩 오리지널",
  "price": 1700,
  "categoryId": {{subCategoryId}},
  "imageUrl": "https://example.com/pocachip.png",
  "productUrl": "https://example.com/products/pocachip"
}

### 15. 선택 항목 없이 등록 (201 예상)
# imageUrl, productUrl은 선택 항목
POST {{baseUrl}}/products
Content-Type: application/json

{ "name": "꼬깔콘", "price": 1500, "categoryId": {{subCategoryId}} }

### --- 검증 에러 ---

### 16. 정렬 조건 오타 (400 예상)
# "정렬 조건은 latest, popular, priceAsc, priceDesc만 가능합니다."
GET {{baseUrl}}/products?sort=cheap

### 17. page 0 (400 예상)
# "page는 1 이상이어야 합니다."
GET {{baseUrl}}/products?page=0

### 18. limit 초과 (400 예상)
# "limit은 100 이하여야 합니다."
GET {{baseUrl}}/products?limit=101

### 19. 상품명 빈 문자열 (400 예상)
# "상품명은 1자 이상이어야 합니다."
POST {{baseUrl}}/products
Content-Type: application/json

{ "name": "", "price": 1500, "categoryId": {{subCategoryId}} }

### 19-1. 상품명이 문자열이 아님 (400 예상)
# "상품명은 문자열이어야 합니다." (없으면 "상품명은 필수 값입니다.")
POST {{baseUrl}}/products
Content-Type: application/json

{ "name": 12345, "price": 1500, "categoryId": {{subCategoryId}} }

### 20. 가격 음수 (400 예상)
# "가격은 0 이상이어야 합니다."
POST {{baseUrl}}/products
Content-Type: application/json

{ "name": "마이너스과자", "price": -100, "categoryId": {{subCategoryId}} }

### 20-1. 가격 null (400 예상)
# 프론트 폼이 가격을 비우면 null을 보낸다. 0원으로 저장되면 안 됨
# "가격은 필수 값입니다."
POST {{baseUrl}}/products
Content-Type: application/json

{ "name": "가격없는과자", "price": null, "categoryId": {{subCategoryId}} }

### 21. 이미지 URL 형식 오류 (400 예상)
# "올바른 이미지 URL이 아닙니다."
POST {{baseUrl}}/products
Content-Type: application/json

{
  "name": "주소틀린과자",
  "price": 1500,
  "categoryId": {{subCategoryId}},
  "imageUrl": "not-a-url"
}

### 22. 없는 카테고리 (400 예상)
# "존재하지 않는 카테고리입니다."
# code가 VALIDATION_ERROR가 아니라 BAD_REQUEST — 형식은 맞는데 DB에 없는 경우라서
POST {{baseUrl}}/products
Content-Type: application/json

{ "name": "카테고리없는과자", "price": 1500, "categoryId": 99999 }

### 23. 수정할 내용 없음 (400 예상)
# "수정할 내용이 없습니다."
PATCH {{baseUrl}}/products/{{myProductId}}
Content-Type: application/json

{}

### --- 권한: 수정·삭제는 작성자 본인 또는 ADMIN 이상 ---

### 24. 본인 상품 수정 (200 예상)
PATCH {{baseUrl}}/products/{{myProductId}}
Content-Type: application/json

{ "price": 1800 }

### 24-1. 이미지 비우기 (200 예상)
# 수정 모달의 이미지 삭제 버튼에 대응. data.imageUrl이 null이 되어야 함
PATCH {{baseUrl}}/products/{{myProductId}}
Content-Type: application/json

{ "imageUrl": null }

### 24-2. 제품 링크 비우기 - 빈 문자열 (200 예상)
# 입력칸을 지우면 프론트가 ""를 보낸다. null로 저장되어야 함
PATCH {{baseUrl}}/products/{{myProductId}}
Content-Type: application/json

{ "productUrl": "" }

### 25. 남(admin)이 등록한 상품 수정 시도 (403 예상)
# "본인이 등록한 상품만 수정하거나 삭제할 수 있습니다."
PATCH {{baseUrl}}/products/{{seedProductId}}
Content-Type: application/json

{ "price": 9999 }

### 26. 로그인 - 다른 일반 유저
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "staff01@snack.com", "password": "Password123!" }

### 27. 다른 일반 유저가 user의 상품 수정 시도 (403 예상)
PATCH {{baseUrl}}/products/{{myProductId}}
Content-Type: application/json

{ "name": "남이바꾼이름" }

### 28. 다른 일반 유저가 user의 상품 삭제 시도 (403 예상)
DELETE {{baseUrl}}/products/{{myProductId}}

### 29. 로그인 - 관리자
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "admin@snack.com", "password": "Password123!" }

### 30. 관리자가 user의 상품 수정 (200 예상)
# 본인 상품이 아니어도 ADMIN 이상이라 가능
PATCH {{baseUrl}}/products/{{myProductId}}
Content-Type: application/json

{ "name": "포카칩 오리지널 대용량", "price": 3200 }

### --- 삭제 ---

### 31. 관리자가 상품 삭제 (200 예상)
# 소프트 삭제. 응답은 data.id 만
DELETE {{baseUrl}}/products/{{myProductId}}

### 32. 삭제한 상품 상세 (404 예상)
GET {{baseUrl}}/products/{{myProductId}}

### 33. 삭제한 상품 재삭제 (404 예상)
# 이미 삭제된 상품은 조회 단계에서 없는 상품으로 처리됨
DELETE {{baseUrl}}/products/{{myProductId}}

### --- 변경 이력 (관리자 이상) ---

### 33-1. 일반 유저가 이력 조회 (403 예상)
# 위에서 일반 유저로 로그인한 상태라면 "상품 변경 이력은 관리자만 볼 수 있습니다."
GET {{baseUrl}}/products/{{myProductId}}/history

### 33-2. 로그인 - 관리자
POST {{baseUrl}}/auth/signin
Content-Type: application/json

{ "email": "admin@snack.com", "password": "Password123!" }

### 33-3. 삭제한 상품의 이력 조회 (200 예상)
# 최신순으로 DELETE → UPDATE → CREATE. 같은 값으로 다시 저장한 수정은 남지 않음
# @name historyFirst
GET {{baseUrl}}/products/{{myProductId}}/history?limit=2

### 33-4. 이력 다음 묶음 (200 예상)
GET {{baseUrl}}/products/{{myProductId}}/history?limit=2&cursor={{historyFirst.response.body.data.nextCursor}}

### --- 인증 ---

### 34. 로그아웃
# 서버가 쿠키 삭제 응답을 보내므로 클라이언트 저장소에서도 사라짐
POST {{baseUrl}}/auth/signout

### 35. 쿠키 없이 목록 조회 (401 예상)
# "로그인이 필요합니다."
GET {{baseUrl}}/products

### 36. 시드 초기화
# 위 테스트로 상품이 추가·수정·삭제되었으므로 터미널에서 npm run seed 실행
